# Copy to .env.local and fill in. .env.local is gitignored — keep it that way.
# Restart `npm run dev` after any change here; env vars are read at boot.

# --- Supabase ---------------------------------------------------------------
# Dashboard -> Project Settings -> Data API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Dashboard -> Project Settings -> API keys -> anon / publishable.
# Used for auth only: signing in and reading the current session.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Dashboard -> Project Settings -> API keys -> service_role (or sb_secret_...).
#
# Server-only, and it BYPASSES ROW-LEVEL SECURITY — this is a full-database
# credential. Never reference it from a client component; `lib/supabase/admin`
# imports "server-only" so that mistake fails the build rather than shipping.
#
# Every dashboard read uses it, because an operator needs everyone's rows from
# users, plans, pending_claims and transactions, and `anon` is not entitled to
# them. Without it the pages render a "key not configured" card.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# --- Who is allowed in ------------------------------------------------------
# Comma-separated allowlist, compared case-insensitively. A signed-in address
# that is not on this list gets the forbidden card, not a redirect.
#
# The account itself lives in Supabase Auth: create it (and set or reset its
# password) at Dashboard -> Authentication -> Users, with "Auto Confirm User"
# ticked. Being in Supabase is not enough on its own — the address has to be
# here too, and changing this list means a redeploy.
ADMIN_EMAILS=you@example.com,ops@example.com
